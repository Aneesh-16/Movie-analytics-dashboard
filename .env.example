# Copy to .env (never commit .env). Real environment variables override this file.
# Supabase: Project -> Connect -> copy the connection string (use the pooler string if your host is IPv4-only, e.g. Render).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Long random string, e.g.  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Where the deployed API lives (documentation only), e.g. https://your-service.onrender.com
API_BASE_URL=
# Origins allowed to call the API from a browser (your dashboard + partner site), comma separated, e.g. https://my-app.onrender.com. Leave empty to block cross-origin calls. "*" only for local demos.
CORS_ORIGINS=
# Optional poster enrichment (official TMDB API). Server/CLI only - never put these in browser code.
TMDB_READ_TOKEN=
TMDB_API_KEY=
